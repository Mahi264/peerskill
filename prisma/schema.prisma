generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model AppMetadata {
  key       String   @id
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("app_metadata")
}

model User {
  id                   String       @id @default(cuid())
  email                String       @unique
  googleId             String?      @unique
  passwordHash         String?
  collegeEmailVerified Boolean      @default(false)
  status               UserStatus   @default(PENDING)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  sessions             Session[]
  profile              Profile?
  userSkills           UserSkill[]
  doubts               Doubt[]
  answers              Answer[]
  attachments          Attachment[]
  sentConnections     Connection[]   @relation("SentConnections")
  receivedConnections Connection[]   @relation("ReceivedConnections")
  conversationsAsUserOne Conversation[] @relation("ConversationUserOne")
  conversationsAsUserTwo Conversation[] @relation("ConversationUserTwo")
  sentMessages        Message[]      @relation("SentMessages")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Profile {
  userId                 String     @id
  fullName               String
  avatarUrl              String?
  branch                 String?
  graduationYear         Int?
  section                String?
  bio                    String?
  helpAvailable          Boolean    @default(true)
  helpStatus             String?
  contactVisibility      Visibility @default(CONNECTIONS)
  chatRequestVisibility Visibility @default(CONNECTIONS)
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Skill {
  id          String       @id @default(cuid())
  name        String       @unique
  slug        String       @unique
  category    String?
  createdAt   DateTime     @default(now())
  userSkills  UserSkill[]
  doubtSkills DoubtSkill[]
}

model UserSkill {
  id        String     @id @default(cuid())
  userId    String
  skillId   String
  level     SkillLevel @default(BEGINNER)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId])
  @@index([skillId, level])
}

model Doubt {
  id               String       @id @default(cuid())
  authorId         String
  title            String
  body             String
  urgency          DoubtUrgency @default(CURIOUS)
  status           DoubtStatus  @default(OPEN)
  acceptedAnswerId String?
  answerCount      Int          @default(0)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  author      User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  skills      DoubtSkill[]
  answers     Answer[]
  attachments Attachment[]

  @@index([authorId])
  @@index([status])
  @@index([urgency])
}

model DoubtSkill {
  doubtId String
  skillId String

  doubt Doubt @relation(fields: [doubtId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([doubtId, skillId])
  @@index([skillId])
}

model Answer {
  id         String   @id @default(cuid())
  doubtId    String
  authorId   String
  body       String
  isAccepted Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  doubt       Doubt        @relation(fields: [doubtId], references: [id], onDelete: Cascade)
  author      User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  attachments Attachment[]

  @@index([doubtId])
  @@index([authorId])
}

model Attachment {
  id            String   @id @default(cuid())
  ownerType     String
  ownerId       String
  uploaderId    String
  fileUrl       String
  fileName      String
  mimeType      String
  fileSizeBytes Int
  createdAt     DateTime @default(now())

  uploader User    @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  doubt    Doubt?  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  answer   Answer? @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([uploaderId])
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  MENTOR
}

enum Visibility {
  NOBODY
  CONNECTIONS
  COLLEGE
}

enum DoubtUrgency {
  CURIOUS
  ASSIGNMENT_STUCK
  PROJECT_BLOCKED
  EXAM_PREP
}

enum DoubtStatus {
  OPEN
  RESOLVED
  CLOSED
}

enum ConnectionStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model Connection {
  id          String           @id @default(cuid())
  requesterId String
  receiverId  String
  status      ConnectionStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  acceptedAt  DateTime?

  requester   User             @relation("SentConnections", fields: [requesterId], references: [id], onDelete: Cascade)
  receiver    User             @relation("ReceivedConnections", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([requesterId, receiverId])
  @@index([receiverId, status])
  @@index([requesterId, status])
}

model Conversation {
  id        String    @id @default(cuid())
  userOneId String
  userTwoId String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  userOne   User      @relation("ConversationUserOne", fields: [userOneId], references: [id], onDelete: Cascade)
  userTwo   User      @relation("ConversationUserTwo", fields: [userTwoId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@unique([userOneId, userTwoId])
  @@index([userOneId])
  @@index([userTwoId])
  @@index([updatedAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  body           String
  createdAt      DateTime     @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderId])
}

model AdminAccount {
  id          String         @id @default(cuid())
  email       String         @unique
  googleId    String?        @unique
  displayName String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  sessions    AdminSession[]
  auditLogs   AdminAuditLog[]
}

model AdminSession {
  id             String       @id @default(cuid())
  adminAccountId String
  tokenHash      String       @unique
  expiresAt      DateTime
  createdAt      DateTime     @default(now())

  adminAccount   AdminAccount @relation(fields: [adminAccountId], references: [id], onDelete: Cascade)

  @@index([adminAccountId])
}

model AdminAuditLog {
  id             String        @id @default(cuid())
  adminAccountId String?
  action         String
  details        String?
  ipAddress      String?
  createdAt      DateTime      @default(now())

  adminAccount   AdminAccount? @relation(fields: [adminAccountId], references: [id], onDelete: SetNull)

  @@index([adminAccountId])
  @@index([action])
  @@index([createdAt])
}
