generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model AppMetadata {
  key       String   @id
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("app_metadata")
}

model User {
  id                   String       @id @default(cuid())
  email                String       @unique
  googleId             String?      @unique
  passwordHash         String?
  collegeEmailVerified Boolean      @default(false)
  role                 UserRole     @default(STUDENT)
  status               UserStatus   @default(PENDING)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  sessions             Session[]
  profile              Profile?
  userSkills           UserSkill[]
  doubts               Doubt[]
  answers              Answer[]
  attachments          Attachment[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Profile {
  userId                 String     @id
  fullName               String
  avatarUrl              String?
  branch                 String?
  graduationYear         Int?
  section                String?
  bio                    String?
  helpAvailable          Boolean    @default(true)
  helpStatus             String?
  contactVisibility      Visibility @default(CONNECTIONS)
  chatRequestVisibility Visibility @default(CONNECTIONS)
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Skill {
  id          String       @id @default(cuid())
  name        String       @unique
  slug        String       @unique
  category    String?
  createdAt   DateTime     @default(now())
  userSkills  UserSkill[]
  doubtSkills DoubtSkill[]
}

model UserSkill {
  id        String     @id @default(cuid())
  userId    String
  skillId   String
  level     SkillLevel @default(BEGINNER)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId])
  @@index([skillId, level])
}

model Doubt {
  id               String       @id @default(cuid())
  authorId         String
  title            String
  body             String
  urgency          DoubtUrgency @default(CURIOUS)
  status           DoubtStatus  @default(OPEN)
  acceptedAnswerId String?
  answerCount      Int          @default(0)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  author      User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  skills      DoubtSkill[]
  answers     Answer[]
  attachments Attachment[]

  @@index([authorId])
  @@index([status])
  @@index([urgency])
}

model DoubtSkill {
  doubtId String
  skillId String

  doubt Doubt @relation(fields: [doubtId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([doubtId, skillId])
  @@index([skillId])
}

model Answer {
  id         String   @id @default(cuid())
  doubtId    String
  authorId   String
  body       String
  isAccepted Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  doubt       Doubt        @relation(fields: [doubtId], references: [id], onDelete: Cascade)
  author      User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  attachments Attachment[]

  @@index([doubtId])
  @@index([authorId])
}

model Attachment {
  id            String   @id @default(cuid())
  ownerType     String
  ownerId       String
  uploaderId    String
  fileUrl       String
  fileName      String
  mimeType      String
  fileSizeBytes Int
  createdAt     DateTime @default(now())

  uploader User    @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  doubt    Doubt?  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  answer   Answer? @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([uploaderId])
}

enum UserRole {
  STUDENT
  ADMIN
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  MENTOR
}

enum Visibility {
  NOBODY
  CONNECTIONS
  COLLEGE
}

enum DoubtUrgency {
  CURIOUS
  ASSIGNMENT_STUCK
  PROJECT_BLOCKED
  EXAM_PREP
}

enum DoubtStatus {
  OPEN
  RESOLVED
  CLOSED
}
